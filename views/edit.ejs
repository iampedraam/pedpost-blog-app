<%- include('partials/header') %>

<section class="edit-post-area">
    <div class="card edit-card">
        <h2>Edit PedPost</h2>
        <form action="/edit/<%= post.id %>?_method=PUT" method="POST" class="stacked-form">
            <input type="text" name="title" value="<%= post.title %>" required>
            <input type="text" name="publisher" value="<%= post.publisher %>" required>
            <textarea name="content" rows="8" required><%= post.content %></textarea>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</section>

<%- include('partials/footer') %>